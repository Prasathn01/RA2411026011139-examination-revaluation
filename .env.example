# Copy this file to .env before "docker compose up". .env is git-ignored.
# These are TEST values for the local mock services only - no real keys belong in this repo.

# PostgreSQL (application database)
DB_USERNAME=reval
DB_PASSWORD=reval

# Mock Razorpay test keys (the mock payment API accepts these via HTTP basic auth)
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_secret

# SMTP login for the Email connector (Mailpit accepts any login)
SMTP_USERNAME=examcell
SMTP_PASSWORD=mailpit
