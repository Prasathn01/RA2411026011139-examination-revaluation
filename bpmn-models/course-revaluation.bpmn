<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_course_revaluation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">

<bpmn:process id="course-revaluation" name="Course revaluation" isExecutable="true">
<bpmn:startEvent id="Start_Course" name="Course revaluation requested"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_FetchResult" name="Fetch published result" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="GET" target="method" /><zeebe:input source="=camunda.secrets.RESULTS_API_URL + &quot;/results/&quot; + registerNo + &quot;-&quot; + courseCode" target="url" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="JSON" target="documentReturnFormat.choice" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="18" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={courseName: response.body.courseName, courseType: response.body.courseType, originalMarks: response.body.marks, originalGrade: response.body.grade, resultPublishedOn: response.body.publishedOn, originalExaminerId: response.body.examinerId}" /><zeebe:header key="errorExpression" value="=if error.code = &quot;404&quot; then bpmnError(&quot;RESULT_NOT_FOUND&quot;, &quot;No published result for this course&quot;) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Boundary_ResultNotFound" name="Result not found" attachedToRef="Task_FetchResult"><bpmn:outgoing>Flow_ResultNotFound</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_ResultNotFound" errorRef="Error_ResultNotFound" /></bpmn:boundaryEvent>
<bpmn:scriptTask id="Task_Register" name="Register course request"><bpmn:extensionElements><zeebe:script expression="={requestId: &quot;REV-&quot; + registerNo + &quot;-&quot; + courseCode + &quot;-&quot; + string(modulo(floor((now() - date and time(&quot;2026-01-01T00:00:00@UTC&quot;)) / duration(&quot;PT0.001S&quot;)), 100000000)), daysSinceResult: (today() - date(resultPublishedOn)).days, submittedOn: string(today())}" resultVariable="application" /></bpmn:extensionElements><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing></bpmn:scriptTask>
<bpmn:businessRuleTask id="Task_Eligibility" name="Check eligibility and fee"><bpmn:extensionElements><zeebe:calledDecision decisionId="revaluation-eligibility" resultVariable="eligibility" /></bpmn:extensionElements><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="Gateway_Eligible" name="Eligible?" default="Flow_NotEligible"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_Eligible</bpmn:outgoing><bpmn:outgoing>Flow_NotEligible</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:subProcess id="Sub_FeePayment" name="Fee payment"><bpmn:incoming>Flow_Eligible</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing>
<bpmn:startEvent id="Start_Payment" name="Payment started"><bpmn:outgoing>Flow_P1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="Task_PaymentLink" name="Create fee payment link" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="basic" target="authentication.type" /><zeebe:input source="=camunda.secrets.RAZORPAY_KEY_ID" target="authentication.username" /><zeebe:input source="=camunda.secrets.RAZORPAY_KEY_SECRET" target="authentication.password" /><zeebe:input source="POST" target="method" /><zeebe:input source="=camunda.secrets.PAYMENT_API_URL + &quot;/payment_links&quot;" target="url" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="JSON" target="documentReturnFormat.choice" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /><zeebe:input source="={amount: eligibility.fee * 100, currency: &quot;INR&quot;, description: &quot;Revaluation fee - &quot; + courseCode, reference_id: application.requestId, customer: {name: studentName, email: studentEmail}, notify: {email: true}}" target="body" /><zeebe:input source="false" target="ignoreNullValues" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="18" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={paymentLinkId: response.body.id, paymentUrl: response.body.short_url}" /><zeebe:header key="errorExpression" value="=if error != null and error.code != null and matches(error.code, &quot;^[45][0-9][0-9]$&quot;) then bpmnError(&quot;PAYMENT_FAILED&quot;, &quot;Payment service returned HTTP &quot; + error.code) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_P1</bpmn:incoming><bpmn:outgoing>Flow_P2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="Catch_FeePaid" name="Fee paid"><bpmn:incoming>Flow_P2</bpmn:incoming><bpmn:outgoing>Flow_P3</bpmn:outgoing><bpmn:messageEventDefinition id="Catch_FeePaid_def" messageRef="Message_FeePaid" /></bpmn:intermediateCatchEvent>
<bpmn:endEvent id="End_FeeReceived" name="Fee received"><bpmn:incoming>Flow_P3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_P1" sourceRef="Start_Payment" targetRef="Task_PaymentLink" />
<bpmn:sequenceFlow id="Flow_P2" sourceRef="Task_PaymentLink" targetRef="Catch_FeePaid" />
<bpmn:sequenceFlow id="Flow_P3" sourceRef="Catch_FeePaid" targetRef="End_FeeReceived" />
</bpmn:subProcess>
<bpmn:boundaryEvent id="Boundary_PaymentDeadline" name="Payment window over (48 h)" attachedToRef="Sub_FeePayment"><bpmn:outgoing>Flow_Unpaid</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_PaymentDeadline"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=get or else(paymentWindow, &quot;PT48H&quot;)</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="Boundary_PaymentFailed" name="Payment failed" attachedToRef="Sub_FeePayment"><bpmn:outgoing>Flow_PayFailed</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_PaymentFailed" errorRef="Error_PaymentFailed" /></bpmn:boundaryEvent>
<bpmn:subProcess id="Sub_Revaluation" name="Revaluation"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing>
<bpmn:startEvent id="Start_Reval" name="Fee received"><bpmn:outgoing>Flow_R1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="Task_CoeAssign" name="CoE assigns examiner"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="assign-examiner" /><zeebe:assignmentDefinition candidateGroups="coe" /></bpmn:extensionElements><bpmn:incoming>Flow_R1</bpmn:incoming><bpmn:outgoing>Flow_R2</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Task_SendLogin" name="Email examiner login"><bpmn:extensionElements><zeebe:taskDefinition type="revaluation.send-examiner-login" retries="3" /><zeebe:ioMapping><zeebe:input source="REVALUATION" target="round" /><zeebe:output source="=assignedExaminer" target="examiner" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_R2</bpmn:incoming><bpmn:outgoing>Flow_R3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Task_Revalue" name="Revalue answer script (blind)"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="revalue-script" /><zeebe:assignmentDefinition assignee="=examiner.username" /></bpmn:extensionElements><bpmn:incoming>Flow_R3</bpmn:incoming><bpmn:outgoing>Flow_R6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_JoinValuation"><bpmn:incoming>Flow_R6</bpmn:incoming><bpmn:incoming>Flow_ThirdLoop</bpmn:incoming><bpmn:outgoing>Flow_R7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="Task_CompareMarks" name="Compare marks"><bpmn:extensionElements><zeebe:script expression="=revaluedMarks - originalMarks" resultVariable="markDifference" /></bpmn:extensionElements><bpmn:incoming>Flow_R7</bpmn:incoming><bpmn:outgoing>Flow_R8</bpmn:outgoing></bpmn:scriptTask>
<bpmn:businessRuleTask id="Task_DecideOutcome" name="Decide outcome and grade"><bpmn:extensionElements><zeebe:calledDecision decisionId="revaluation-outcome" resultVariable="decision" /></bpmn:extensionElements><bpmn:incoming>Flow_R8</bpmn:incoming><bpmn:outgoing>Flow_R9</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="Gateway_ThirdValuation" name="Third valuation needed?" default="Flow_NoThird"><bpmn:incoming>Flow_R9</bpmn:incoming><bpmn:outgoing>Flow_ThirdNeeded</bpmn:outgoing><bpmn:outgoing>Flow_NoThird</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="Task_CoeAssignThird" name="CoE assigns third examiner"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="assign-examiner" /><zeebe:assignmentDefinition candidateGroups="coe" /></bpmn:extensionElements><bpmn:incoming>Flow_ThirdNeeded</bpmn:incoming><bpmn:outgoing>Flow_T1</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="Task_SendLoginThird" name="Email third examiner login"><bpmn:extensionElements><zeebe:taskDefinition type="revaluation.send-examiner-login" retries="3" /><zeebe:ioMapping><zeebe:input source="THIRD_VALUATION" target="round" /><zeebe:output source="=assignedExaminer" target="thirdExaminer" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_T1</bpmn:incoming><bpmn:outgoing>Flow_T2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="Task_ThirdValuation" name="Third valuation"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="third-valuation" /><zeebe:assignmentDefinition assignee="=thirdExaminer.username" /><zeebe:ioMapping><zeebe:output source="=thirdValuationMarks" target="revaluedMarks" /><zeebe:output source="=thirdValuationMarks" target="thirdValuationMarks" /><zeebe:output source="=thirdValuationRemarks" target="thirdValuationRemarks" /><zeebe:output source="=true" target="thirdValuationDone" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_T2</bpmn:incoming><bpmn:outgoing>Flow_ThirdLoop</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_RevalDone" name="Revaluation done"><bpmn:incoming>Flow_NoThird</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_R1" sourceRef="Start_Reval" targetRef="Task_CoeAssign" />
<bpmn:sequenceFlow id="Flow_R2" sourceRef="Task_CoeAssign" targetRef="Task_SendLogin" />
<bpmn:sequenceFlow id="Flow_R3" sourceRef="Task_SendLogin" targetRef="Task_Revalue" />
<bpmn:sequenceFlow id="Flow_R6" sourceRef="Task_Revalue" targetRef="Gateway_JoinValuation" />
<bpmn:sequenceFlow id="Flow_R7" sourceRef="Gateway_JoinValuation" targetRef="Task_CompareMarks" />
<bpmn:sequenceFlow id="Flow_R8" sourceRef="Task_CompareMarks" targetRef="Task_DecideOutcome" />
<bpmn:sequenceFlow id="Flow_R9" sourceRef="Task_DecideOutcome" targetRef="Gateway_ThirdValuation" />
<bpmn:sequenceFlow id="Flow_ThirdNeeded" name="Yes" sourceRef="Gateway_ThirdValuation" targetRef="Task_CoeAssignThird"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decision.outcome = &quot;THIRD_VALUATION&quot;</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_T1" sourceRef="Task_CoeAssignThird" targetRef="Task_SendLoginThird" />
<bpmn:sequenceFlow id="Flow_T2" sourceRef="Task_SendLoginThird" targetRef="Task_ThirdValuation" />
<bpmn:sequenceFlow id="Flow_ThirdLoop" sourceRef="Task_ThirdValuation" targetRef="Gateway_JoinValuation" />
<bpmn:sequenceFlow id="Flow_NoThird" name="No" sourceRef="Gateway_ThirdValuation" targetRef="End_RevalDone" />
</bpmn:subProcess>
<bpmn:boundaryEvent id="Boundary_ExaminerDeadline" name="Not done in 72 h" cancelActivity="false" attachedToRef="Sub_Revaluation"><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:timerEventDefinition id="TimerDef_ExaminerDeadline"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=get or else(examinerDeadline, &quot;PT72H&quot;)</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:userTask id="Task_Escalate" name="Escalate delay to CoE"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="exam-cell-action" /><zeebe:assignmentDefinition candidateGroups="coe" /></bpmn:extensionElements><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="End_Escalated" name="Delay escalated"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="Task_PublishResult" name="Publish result" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="noAuth" target="authentication.type" /><zeebe:input source="PATCH" target="method" /><zeebe:input source="=camunda.secrets.RESULTS_API_URL + &quot;/results/&quot; + registerNo + &quot;-&quot; + courseCode" target="url" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="JSON" target="documentReturnFormat.choice" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /><zeebe:input source="={revaluation: {requestId: application.requestId, outcome: decision.outcome, finalMarks: decision.finalMarks, finalGrade: decision.grade, completedOn: string(today())}}" target="body" /><zeebe:input source="false" target="ignoreNullValues" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="18" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={resultUpdatedAt: response.body.updatedAt}" /><zeebe:header key="errorExpression" value="=if error != null then bpmnError(&quot;RESULT_UPDATE_FAILED&quot;, &quot;Result could not be published&quot;) else null" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:boundaryEvent id="Boundary_PublishFailed" name="Update failed" attachedToRef="Task_PublishResult"><bpmn:outgoing>Flow_PublishFailed</bpmn:outgoing><bpmn:errorEventDefinition id="ErrDef_PublishFailed" errorRef="Error_PublishFailed" /></bpmn:boundaryEvent>
<bpmn:userTask id="Task_ManualUpdate" name="Update result manually"><bpmn:extensionElements><zeebe:userTask /><zeebe:formDefinition formId="exam-cell-action" /><zeebe:assignmentDefinition candidateGroups="coe" /></bpmn:extensionElements><bpmn:incoming>Flow_PublishFailed</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Gateway_JoinPublish"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="Gateway_Refund" name="Fee refundable?" default="Flow_NoRefund"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_Refund</bpmn:outgoing><bpmn:outgoing>Flow_NoRefund</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_Refund" name="Refund revaluation fee" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" /><zeebe:ioMapping><zeebe:input source="basic" target="authentication.type" /><zeebe:input source="=camunda.secrets.RAZORPAY_KEY_ID" target="authentication.username" /><zeebe:input source="=camunda.secrets.RAZORPAY_KEY_SECRET" target="authentication.password" /><zeebe:input source="POST" target="method" /><zeebe:input source="=camunda.secrets.PAYMENT_API_URL + &quot;/payments/&quot; + paymentId + &quot;/refund&quot;" target="url" /><zeebe:input source="false" target="followRedirects" /><zeebe:input source="JSON" target="documentReturnFormat.choice" /><zeebe:input source="20" target="connectionTimeoutInSeconds" /><zeebe:input source="20" target="readTimeoutInSeconds" /><zeebe:input source="={amount: eligibility.fee * 100, notes: {requestId: application.requestId, reason: &quot;Marks increased on revaluation&quot;}}" target="body" /><zeebe:input source="false" target="ignoreNullValues" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="elementTemplateVersion" value="18" /><zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" /><zeebe:header key="resultExpression" value="={refundId: response.body.id, refundStatus: response.body.status}" /><zeebe:header key="retryBackoff" value="PT5S" /></zeebe:taskHeaders></bpmn:extensionElements><bpmn:incoming>Flow_Refund</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="Gateway_JoinRefund"><bpmn:incoming>Flow_NoRefund</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Task_GenerateLetter" name="Generate outcome letter"><bpmn:extensionElements><zeebe:taskDefinition type="revaluation.generate-letter" retries="3" /></bpmn:extensionElements><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:scriptTask id="Task_RecordOutcome" name="Record course result"><bpmn:extensionElements><zeebe:script expression="={courseCode: courseCode, courseName: courseName, requestId: application.requestId, status: if decision.outcome = &quot;RESULT_REVISED&quot; then &quot;CHANGED&quot; else &quot;UNCHANGED&quot;, reason: &quot;Revaluation completed&quot;, originalMarks: originalMarks, finalMarks: decision.finalMarks, grade: decision.grade, refundAmount: if decision.refundFee then eligibility.fee else 0, examinerName: if get or else(thirdValuationDone, false) then examiner.name + &quot; (third valuation: &quot; + thirdExaminer.name + &quot;)&quot; else examiner.name, letterUrl: letter.url}" resultVariable="courseResult" /></bpmn:extensionElements><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:scriptTask>
<bpmn:callActivity id="Call_NotifyOutcome" name="Notify student of outcome"><bpmn:extensionElements><zeebe:calledElement processId="notify-stakeholder" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="={role: &quot;STUDENT&quot;, name: studentName, email: studentEmail}" target="recipient" /><zeebe:input source="=&quot;Revaluation result - &quot; + courseCode" target="subject" /><zeebe:input source="=&quot;Dear &quot; + studentName + &quot;,

Revaluation of &quot; + courseCode + &quot; (&quot; + courseName + &quot;) is complete.
Marks before: &quot; + string(originalMarks) + &quot;
Final marks: &quot; + string(decision.finalMarks) + &quot; (grade &quot; + decision.grade + &quot;)
&quot; + (if decision.refundFee then &quot;Your revaluation fee has been refunded.
&quot; else &quot;&quot;) + &quot;Outcome letter: &quot; + letter.url + &quot;

Controller of Examinations&quot;" target="body" /><zeebe:input source="=applicationId" target="applicationId" /><zeebe:input source="=get or else(application.requestId, null)" target="requestId" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_Completed" name="Revaluation completed"><bpmn:incoming>Flow_24</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="Gateway_JoinRejection"><bpmn:incoming>Flow_NotEligible</bpmn:incoming><bpmn:incoming>Flow_ResultNotFound</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:scriptTask id="Task_RecordRejection" name="Record rejection"><bpmn:extensionElements><zeebe:script expression="={courseCode: courseCode, courseName: courseName, requestId: application.requestId, status: &quot;REJECTED&quot;, reason: get or else(eligibility.reason, &quot;No published result was found for this course.&quot;), originalMarks: originalMarks, finalMarks: null, grade: null, refundAmount: 0, examinerName: null, letterUrl: null}" resultVariable="courseResult" /></bpmn:extensionElements><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:scriptTask>
<bpmn:callActivity id="Call_NotifyRejection" name="Notify rejection"><bpmn:extensionElements><zeebe:calledElement processId="notify-stakeholder" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="={role: &quot;STUDENT&quot;, name: studentName, email: studentEmail}" target="recipient" /><zeebe:input source="=&quot;Revaluation request not accepted - &quot; + courseCode" target="subject" /><zeebe:input source="=&quot;Dear &quot; + studentName + &quot;,

Your revaluation request for &quot; + courseCode + &quot; was not accepted.
Reason: &quot; + courseResult.reason + &quot;

Examination Cell&quot;" target="body" /><zeebe:input source="=applicationId" target="applicationId" /><zeebe:input source="=get or else(application.requestId, null)" target="requestId" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_Rejected" name="Request rejected"><bpmn:incoming>Flow_07</bpmn:incoming></bpmn:endEvent>
<bpmn:scriptTask id="Task_RecordUnpaid" name="Record cancellation (unpaid)"><bpmn:extensionElements><zeebe:script expression="={courseCode: courseCode, courseName: courseName, requestId: application.requestId, status: &quot;CANCELLED&quot;, reason: &quot;The fee was not paid within the payment window.&quot;, originalMarks: originalMarks, finalMarks: null, grade: null, refundAmount: 0, examinerName: null, letterUrl: null}" resultVariable="courseResult" /></bpmn:extensionElements><bpmn:incoming>Flow_Unpaid</bpmn:incoming><bpmn:outgoing>Flow_09</bpmn:outgoing></bpmn:scriptTask>
<bpmn:scriptTask id="Task_RecordPaymentFailed" name="Record cancellation (payment failed)"><bpmn:extensionElements><zeebe:script expression="={courseCode: courseCode, courseName: courseName, requestId: application.requestId, status: &quot;CANCELLED&quot;, reason: &quot;The payment service could not create a payment link. No money was taken.&quot;, originalMarks: originalMarks, finalMarks: null, grade: null, refundAmount: 0, examinerName: null, letterUrl: null}" resultVariable="courseResult" /></bpmn:extensionElements><bpmn:incoming>Flow_PayFailed</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:scriptTask>
<bpmn:exclusiveGateway id="Gateway_JoinCancel"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="Call_NotifyCancelled" name="Notify cancellation"><bpmn:extensionElements><zeebe:calledElement processId="notify-stakeholder" propagateAllChildVariables="false" propagateAllParentVariables="false" /><zeebe:ioMapping><zeebe:input source="={role: &quot;STUDENT&quot;, name: studentName, email: studentEmail}" target="recipient" /><zeebe:input source="=&quot;Revaluation request cancelled - &quot; + courseCode" target="subject" /><zeebe:input source="=&quot;Dear &quot; + studentName + &quot;,

Revaluation request &quot; + string(application.requestId) + &quot; was cancelled.
Reason: &quot; + courseResult.reason + &quot;

Examination Cell&quot;" target="body" /><zeebe:input source="=applicationId" target="applicationId" /><zeebe:input source="=get or else(application.requestId, null)" target="requestId" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_Cancelled" name="Request cancelled"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
