{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.40.0"
  },
  "schemaVersion": 19,
  "id": "third-valuation",
  "type": "default",
  "components": [
    {
      "type": "text",
      "text": "#### Third valuation \u2013 {{courseCode}} {{courseName}}\nThe first revaluation differed from the original by more than 15 marks. Value the script independently; this mark is final.",
      "id": "Field_third_valuation_0"
    },
    {
      "type": "number",
      "key": "thirdValuationMarks",
      "label": "Third valuation marks (out of 100)",
      "validate": {
        "required": true,
        "min": 0,
        "max": 100
      },
      "id": "Field_third_valuation_1"
    },
    {
      "type": "textarea",
      "key": "thirdValuationRemarks",
      "label": "Remarks",
      "id": "Field_third_valuation_2"
    }
  ]
}