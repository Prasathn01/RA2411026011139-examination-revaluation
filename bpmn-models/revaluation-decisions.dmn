<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="revaluation-decisions" name="Revaluation decisions" namespace="http://camunda.org/schema/1.0/dmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
<decision id="revaluation-eligibility" name="Revaluation eligibility and fee"><decisionTable id="DecisionTable_revaluation_eligibility" hitPolicy="FIRST"><input id="Input_revaluation_eligibility_0" label="Days since result"><inputExpression id="InputExpression_revaluation_eligibility_0" typeRef="number"><text>application.daysSinceResult</text></inputExpression></input><input id="Input_revaluation_eligibility_1" label="Course type"><inputExpression id="InputExpression_revaluation_eligibility_1" typeRef="string"><text>courseType</text></inputExpression></input><output id="Output_revaluation_eligibility_0" label="Eligible" name="eligible" typeRef="boolean" /><output id="Output_revaluation_eligibility_1" label="Fee (INR)" name="fee" typeRef="number" /><output id="Output_revaluation_eligibility_2" label="Reason" name="reason" typeRef="string" /><rule id="Rule_revaluation_eligibility_0"><description>Cannot apply before results are out</description><inputEntry id="In_revaluation_eligibility_0_0"><text>&lt; 0</text></inputEntry><inputEntry id="In_revaluation_eligibility_0_1"><text></text></inputEntry><outputEntry id="Out_revaluation_eligibility_0_0"><text>false</text></outputEntry><outputEntry id="Out_revaluation_eligibility_0_1"><text>0</text></outputEntry><outputEntry id="Out_revaluation_eligibility_0_2"><text>"Result not yet published"</text></outputEntry></rule><rule id="Rule_revaluation_eligibility_1"><description>7-day application window</description><inputEntry id="In_revaluation_eligibility_1_0"><text>&gt; 7</text></inputEntry><inputEntry id="In_revaluation_eligibility_1_1"><text></text></inputEntry><outputEntry id="Out_revaluation_eligibility_1_0"><text>false</text></outputEntry><outputEntry id="Out_revaluation_eligibility_1_1"><text>0</text></outputEntry><outputEntry id="Out_revaluation_eligibility_1_2"><text>"Application window closed (7 days from result publication)"</text></outputEntry></rule><rule id="Rule_revaluation_eligibility_2"><description>Theory exams are revalued</description><inputEntry id="In_revaluation_eligibility_2_0"><text></text></inputEntry><inputEntry id="In_revaluation_eligibility_2_1"><text>"THEORY"</text></inputEntry><outputEntry id="Out_revaluation_eligibility_2_0"><text>true</text></outputEntry><outputEntry id="Out_revaluation_eligibility_2_1"><text>1000</text></outputEntry><outputEntry id="Out_revaluation_eligibility_2_2"><text>"Eligible for revaluation"</text></outputEntry></rule><rule id="Rule_revaluation_eligibility_3"><description>Only the theory paper is revalued</description><inputEntry id="In_revaluation_eligibility_3_0"><text></text></inputEntry><inputEntry id="In_revaluation_eligibility_3_1"><text>"LAB_INTEGRATED_THEORY"</text></inputEntry><outputEntry id="Out_revaluation_eligibility_3_0"><text>true</text></outputEntry><outputEntry id="Out_revaluation_eligibility_3_1"><text>1000</text></outputEntry><outputEntry id="Out_revaluation_eligibility_3_2"><text>"Eligible: theory component will be revalued"</text></outputEntry></rule><rule id="Rule_revaluation_eligibility_4"><description>Catch-all: everything else is not eligible</description><inputEntry id="In_revaluation_eligibility_4_0"><text></text></inputEntry><inputEntry id="In_revaluation_eligibility_4_1"><text></text></inputEntry><outputEntry id="Out_revaluation_eligibility_4_0"><text>false</text></outputEntry><outputEntry id="Out_revaluation_eligibility_4_1"><text>0</text></outputEntry><outputEntry id="Out_revaluation_eligibility_4_2"><text>"Practical, project and internal assessments are not revalued"</text></outputEntry></rule></decisionTable></decision>
<decision id="revaluation-outcome" name="Revaluation outcome"><informationRequirement id="InformationRequirement_grade"><requiredDecision href="#marksToGrade" /></informationRequirement><decisionTable id="DecisionTable_revaluation_outcome" hitPolicy="FIRST"><input id="Input_revaluation_outcome_0" label="Third valuation done?"><inputExpression id="InputExpression_revaluation_outcome_0" typeRef="boolean"><text>get or else(thirdValuationDone, false)</text></inputExpression></input><input id="Input_revaluation_outcome_1" label="Deviation (absolute)"><inputExpression id="InputExpression_revaluation_outcome_1" typeRef="number"><text>abs(markDifference)</text></inputExpression></input><input id="Input_revaluation_outcome_2" label="Mark difference"><inputExpression id="InputExpression_revaluation_outcome_2" typeRef="number"><text>markDifference</text></inputExpression></input><output id="Output_revaluation_outcome_0" label="Outcome" name="outcome" typeRef="string" /><output id="Output_revaluation_outcome_1" label="Final marks" name="finalMarks" typeRef="number" /><output id="Output_revaluation_outcome_2" label="Refund fee" name="refundFee" typeRef="boolean" /><output id="Output_revaluation_outcome_3" label="Grade" name="grade" typeRef="string" /><output id="Output_revaluation_outcome_4" label="Grade point" name="gradePoint" typeRef="number" /><rule id="Rule_revaluation_outcome_0"><description>Large deviation: independent third valuation</description><inputEntry id="In_revaluation_outcome_0_0"><text>false</text></inputEntry><inputEntry id="In_revaluation_outcome_0_1"><text>&gt; 15</text></inputEntry><inputEntry id="In_revaluation_outcome_0_2"><text></text></inputEntry><outputEntry id="Out_revaluation_outcome_0_0"><text>"THIRD_VALUATION"</text></outputEntry><outputEntry id="Out_revaluation_outcome_0_1"><text>null</text></outputEntry><outputEntry id="Out_revaluation_outcome_0_2"><text>false</text></outputEntry><outputEntry id="Out_revaluation_outcome_0_3"><text>null</text></outputEntry><outputEntry id="Out_revaluation_outcome_0_4"><text>null</text></outputEntry></rule><rule id="Rule_revaluation_outcome_1"><description>Marks increased: result revised and fee refunded</description><inputEntry id="In_revaluation_outcome_1_0"><text></text></inputEntry><inputEntry id="In_revaluation_outcome_1_1"><text></text></inputEntry><inputEntry id="In_revaluation_outcome_1_2"><text>&gt; 0</text></inputEntry><outputEntry id="Out_revaluation_outcome_1_0"><text>"RESULT_REVISED"</text></outputEntry><outputEntry id="Out_revaluation_outcome_1_1"><text>revaluedMarks</text></outputEntry><outputEntry id="Out_revaluation_outcome_1_2"><text>true</text></outputEntry><outputEntry id="Out_revaluation_outcome_1_3"><text>marksToGrade.grade</text></outputEntry><outputEntry id="Out_revaluation_outcome_1_4"><text>marksToGrade.gradePoint</text></outputEntry></rule><rule id="Rule_revaluation_outcome_2"><description>No increase: original marks stand (never reduced)</description><inputEntry id="In_revaluation_outcome_2_0"><text></text></inputEntry><inputEntry id="In_revaluation_outcome_2_1"><text></text></inputEntry><inputEntry id="In_revaluation_outcome_2_2"><text>&lt;= 0</text></inputEntry><outputEntry id="Out_revaluation_outcome_2_0"><text>"NO_CHANGE"</text></outputEntry><outputEntry id="Out_revaluation_outcome_2_1"><text>originalMarks</text></outputEntry><outputEntry id="Out_revaluation_outcome_2_2"><text>false</text></outputEntry><outputEntry id="Out_revaluation_outcome_2_3"><text>marksToGrade.grade</text></outputEntry><outputEntry id="Out_revaluation_outcome_2_4"><text>marksToGrade.gradePoint</text></outputEntry></rule></decisionTable></decision>
<decision id="marksToGrade" name="Marks to grade"><decisionTable id="DecisionTable_marks_to_grade" hitPolicy="UNIQUE"><input id="Input_marks_to_grade_0" label="Final marks (higher of revalued and original)"><inputExpression id="InputExpression_marks_to_grade_0" typeRef="number"><text>max(revaluedMarks, originalMarks)</text></inputExpression></input><output id="Output_marks_to_grade_0" label="Grade" name="grade" typeRef="string" /><output id="Output_marks_to_grade_1" label="Grade point" name="gradePoint" typeRef="number" /><rule id="Rule_marks_to_grade_0"><description>Outstanding</description><inputEntry id="In_marks_to_grade_0_0"><text>&gt;= 91</text></inputEntry><outputEntry id="Out_marks_to_grade_0_0"><text>"O"</text></outputEntry><outputEntry id="Out_marks_to_grade_0_1"><text>10</text></outputEntry></rule><rule id="Rule_marks_to_grade_1"><description>Excellent</description><inputEntry id="In_marks_to_grade_1_0"><text>[81..91)</text></inputEntry><outputEntry id="Out_marks_to_grade_1_0"><text>"A+"</text></outputEntry><outputEntry id="Out_marks_to_grade_1_1"><text>9</text></outputEntry></rule><rule id="Rule_marks_to_grade_2"><description>Very good</description><inputEntry id="In_marks_to_grade_2_0"><text>[71..81)</text></inputEntry><outputEntry id="Out_marks_to_grade_2_0"><text>"A"</text></outputEntry><outputEntry id="Out_marks_to_grade_2_1"><text>8</text></outputEntry></rule><rule id="Rule_marks_to_grade_3"><description>Good</description><inputEntry id="In_marks_to_grade_3_0"><text>[61..71)</text></inputEntry><outputEntry id="Out_marks_to_grade_3_0"><text>"B+"</text></outputEntry><outputEntry id="Out_marks_to_grade_3_1"><text>7</text></outputEntry></rule><rule id="Rule_marks_to_grade_4"><description>Above average</description><inputEntry id="In_marks_to_grade_4_0"><text>[56..61)</text></inputEntry><outputEntry id="Out_marks_to_grade_4_0"><text>"B"</text></outputEntry><outputEntry id="Out_marks_to_grade_4_1"><text>6</text></outputEntry></rule><rule id="Rule_marks_to_grade_5"><description>Average (pass)</description><inputEntry id="In_marks_to_grade_5_0"><text>[50..56)</text></inputEntry><outputEntry id="Out_marks_to_grade_5_0"><text>"C"</text></outputEntry><outputEntry id="Out_marks_to_grade_5_1"><text>5</text></outputEntry></rule><rule id="Rule_marks_to_grade_6"><description>Fail</description><inputEntry id="In_marks_to_grade_6_0"><text>&lt; 50</text></inputEntry><outputEntry id="Out_marks_to_grade_6_0"><text>"F"</text></outputEntry><outputEntry id="Out_marks_to_grade_6_1"><text>0</text></outputEntry></rule></decisionTable></decision>
<dmndi:DMNDI><dmndi:DMNDiagram id="DMNDiagram_Revaluation"><dmndi:DMNShape id="DMNShape_revaluation-eligibility" dmnElementRef="revaluation-eligibility"><dc:Bounds height="80" width="180" x="160" y="100" /></dmndi:DMNShape><dmndi:DMNShape id="DMNShape_revaluation-outcome" dmnElementRef="revaluation-outcome"><dc:Bounds height="80" width="180" x="400" y="100" /></dmndi:DMNShape><dmndi:DMNShape id="DMNShape_marksToGrade" dmnElementRef="marksToGrade"><dc:Bounds height="80" width="180" x="400" y="260" /></dmndi:DMNShape><dmndi:DMNEdge id="DMNEdge_grade" dmnElementRef="InformationRequirement_grade"><di:waypoint x="490" y="260" /><di:waypoint x="490" y="180" /></dmndi:DMNEdge></dmndi:DMNDiagram></dmndi:DMNDI>
</definitions>
