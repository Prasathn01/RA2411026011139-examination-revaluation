# Connector secrets for the LOCAL run path (Camunda 8 Run 8.10.6).
# The BPMN never contains these values; it only says =camunda.secrets.NAME.
#
#   1. Copy this file to secrets.env (secrets.env is git-ignored).
#   2. From the c8run folder:  .\c8run.exe secrets import <full path to secrets.env>
#   3. Restart Camunda 8 Run if you change a value (secrets are cached).
#
# The values below point at the local mock services and Mailpit, so they are not real secrets.
# For Docker the same names are set in .env (see .env.example).

RESULTS_API_URL=http://localhost:3000
PAYMENT_API_URL=http://localhost:3000/razorpay/v1
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_secret
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=examcell
SMTP_PASSWORD=mailpit
